{
  "name": "inkwell",
  "version": "1.0.0",
  "private": true,
  "description": "Inkwell · 本地优先的 AI 长篇小说生产工作台",
  "author": "Inkwell",
  "license": "MIT",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "smoke": "electron-vite build && electron . --smoke",
    "smoke:llm": "electron-vite build && electron . --smoke-llm",
    "smoke:mcp": "electron-vite build && electron . --smoke-mcp",
    "smoke:m3": "electron-vite build && electron . --smoke-m3",
    "smoke:m4": "electron-vite build && electron . --smoke-m4",
    "smoke:m5": "electron-vite build && electron . --smoke-m5",
    "smoke:m6": "electron-vite build && electron . --smoke-m6",
    "smoke:m7": "electron-vite build && electron . --smoke-m7",
    "smoke:m8": "electron-vite build && electron . --smoke-m8",
    "smoke:m9": "electron-vite build && electron . --smoke-m9",
    "smoke:m10": "electron-vite build && electron . --smoke-m10",
    "smoke:m11": "electron-vite build && electron . --smoke-m11",
    "clean:release": "node scripts/clean-release.mjs",
    "pack:dir": "npm run clean:release && electron-vite build && electron-builder --win --dir --publish never",
    "dist:win": "npm run clean:release && electron-vite build && electron-builder --win --publish never"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.3",
    "electron-updater": "^6.8.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "zustand": "^5.0.15"
  }
}
